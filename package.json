{
  "name": "maxine-discovery",
  "version": "1.0.1",
  "description": "Maxine is a service discovery and a registry server for all the running nodes with gargantua client dependency.",
  "main": "index.js",
  "scripts": {
    "start": "npm run prod",
    "prod": "node index.js",
    "dev": "nodemon index.js --env dev",
    "test": "npm run unit-test",
    "maxibuild": "npx pkg -t node14-linux-arm64,node14-macos-arm64,node14-win-arm64 --out-path artifacts/build/ .",
    "unit-test": "npx mocha --timeout 10000 --exit",
    "genreports": "nyc --reporter=html --reporter=lcov npm run unit-test",
    "coverage": "npm run genreports && npx codecov -t $CODECOV_TOKEN",
    "load-test": "k6 run src/test/load-test/performance-test.js",
    "bump": "node scripts/bump-version.js"
  },
  "keywords": [
    "maxine",
    "discovery-server",
    "naming-server",
    "registry-server",
    "service-registry"
  ],
  "author": "Vrushank Patel",
  "license": "MIT",
  "bin": "index.js",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "consistent-hashing": "^0.3.0",
    "cors": "^2.8.5",
    "date-and-time": "^2.1.0",
    "enums": "^1.0.3",
    "express": "^4.21.2",
    "express-actuator": "^1.8.0",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "minimist": "^1.2.8",
    "read-last-lines": "^1.8.0",
    "redis": "^4.7.0",
    "swagger-ui-express": "^4.3.0",
    "winston": "^3.5.1",
    "yamljs": "^0.3.0"
  },
  "overrides": {
    "minimist": "^1.2.8",
    "tar": "^7.5.19"
  },
  "nodemonConfig": {
    "ext": "js,properties,yaml"
  },
  "devDependencies": {
    "chai": "^4.3.6",
    "chai-http": "^4.3.0",
    "chai-json": "^1.0.0",
    "codecov": "^3.8.3",
    "istanbul": "^0.4.5",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "nodemon": "^2.0.15",
    "nyc": "^15.1.0",
    "pkg": "5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VrushankPatel/Gargantua-Maxine-Server"
  },
  "nyc": {
    "include": "src",
    "exclude": [
      "**/app-builder.js",
      "**/route-builder.js",
      "**/logging"
    ],
    "excludeArchived": []
  },
  "pkg": {
    "assets": [
      "node_modules/**/*.css",
      "client/**/*"
    ]
  }
}
